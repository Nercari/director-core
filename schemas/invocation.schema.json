{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://director-core.local/schemas/invocation.schema.json",
  "title": "Director invocation ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "work_unit_id",
    "run_id",
    "role",
    "provider",
    "model",
    "started_at"
  ],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "work_unit_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "role": {
      "type": "string",
      "enum": ["director", "executor", "reviewer", "validator", "auxiliary"]
    },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "parent_run_id": { "type": ["string", "null"] },
    "route_id": { "type": ["string", "null"] },
    "executor_id": { "type": ["string", "null"] },
    "task_class": { "type": ["string", "null"] },
    "complexity_band": { "type": ["string", "null"] },
    "effort": { "type": ["string", "null"] },
    "execution_mode": { "type": ["string", "null"] },
    "attempt_number": { "type": ["integer", "null"], "minimum": 0 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cache_creation_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "estimated_cost": { "type": ["number", "null"], "default": null },
    "quota_used_percent": { "type": ["number", "null"], "minimum": 0 },
    "quota_window_minutes": { "type": ["integer", "null"], "minimum": 0 },
    "quota_resets_at": { "type": ["string", "null"], "format": "date-time" },
    "quota_limit_id": { "type": ["string", "null"] },
    "model_context_window": { "type": ["integer", "null"], "minimum": 0 },
    "latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
    "completed": { "type": ["boolean", "null"] },
    "validation_passed": { "type": ["boolean", "null"] },
    "human_intervention": { "type": ["boolean", "null"] },
    "failure_class": { "type": ["string", "null"] },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "telemetry_source": { "type": ["string", "null"] },
    "telemetry_authoritative": { "type": "boolean" },
    "telemetry_unavailable": { "type": "boolean" }
  }
}
