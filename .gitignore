# Local run state — never committed
.director/handoffs/
.director/current-handoff.*
.director/runs/
.director/probes/
.scratch/

# Local telemetry ledger state — never committed
.telemetry/*.jsonl
.telemetry/*.sqlite

# Python bytecode
__pycache__/
*.pyc

# Local settings override
.claude/settings.local.json

# Credentials — belt and braces; §14 forbids these existing at all
.env
.env.*
*.key
*.pem
secrets/

# Worktrees live as siblings, never inside
director-core-*/

# OS noise
Thumbs.db
desktop.ini
.DS_Store
