# Local run state — never committed
.director/handoffs/
.director/current-handoff.*
.director/runs/
.director/probes/
.scratch/

# Local telemetry ledger state — never committed
.telemetry/*.jsonl
.telemetry/*.sqlite
.telemetry/example/

# Python bytecode
__pycache__/
*.pyc

# Local settings override
.claude/settings.local.json

# Credentials — belt and braces; §14 forbids these existing at all
.env
.env.*
*.key
*.pem
secrets/

# Worktrees live as siblings, never inside
director-core-*/

# Runtime hook control, written by scripts/worktree.sh and by the hook selftest.
# Machine state for the session in flight, never repository content — committing
# it changes hook behaviour for every later clone and session.
.director/active-worktree

# Site-specific sanitizer patterns, read by scripts/check-example-sanitization.sh
# when present. Untracked on purpose: a committed denylist of real aliases,
# accounts, and hostnames would publish the topology it exists to protect.
.sanitizer-denylist.local

# OS noise
Thumbs.db
desktop.ini
.DS_Store
